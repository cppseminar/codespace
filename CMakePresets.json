{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 2,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "clang-debug",
            "displayName": "Clang Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "/usr/lib/llvm-22/bin/clang++",
                "CMAKE_CXX_FLAGS": "-stdlib=libc++",
                "CMAKE_CXX_STDLIB_MODULES_JSON": "/usr/lib/llvm-22/lib/libc++.modules.json"
            }
        },
        {
            "name": "clang-release",
            "displayName": "Clang Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "/usr/lib/llvm-22/bin/clang++",
                "CMAKE_CXX_FLAGS": "-stdlib=libc++",
                "CMAKE_CXX_STDLIB_MODULES_JSON": "/usr/lib/llvm-22/lib/libc++.modules.json"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "clang-debug",
            "configurePreset": "clang-debug"
        },
        {
            "name": "clang-release",
            "configurePreset": "clang-release"
        }
    ]
}